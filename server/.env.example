PORT=3000
FRONTEND_URL=http://localhost:5173
DATABASE_URL=postgresql://nexo_app:nexo_local_dev_password@localhost:5432/nexo
DATABASE_SSL=false

# Segredo do servidor para gravar apenas um hash do IP (mínimo 16 caracteres; gere um valor longo e aleatório).
IP_HASH_SECRET=

# Segredo dos QR Codes (mínimo 16 caracteres, aleatório). Trocá-lo invalida todos os QR impressos.
QR_SECRET=

# Endereço público do app, gravado nos QR Codes (ex.: https://nexo.exemplo.com). Usado só pelos comandos qr:*.
PUBLIC_APP_URL=

# Atrás de proxy/HTTPS em produção, use 1 para que o IP real do visitante seja lido.
TRUST_PROXY=0

# Opcionais (valores padrão entre parênteses)
# EVENT_SLUG=procidadania-ceumap
# RESUME_WINDOW_HOURS=6
# PROFILES_PER_IP_PER_HOUR=60
# API_RATE_LIMIT_PER_MIN=300
# RETENTION_DAYS=30

# Painel da equipe (opcional): limite de tentativas de login por IP a cada 15 min (padrão 20).
# ADMIN_LOGIN_LIMIT_PER_15MIN=20

# Publicação (hospedagem sem terminal): conta do staff criada/atualizada automaticamente ao iniciar com `npm run start:prod`.
# Para trocar a senha, mude ADMIN_PASSWORD (mínimo 12 caracteres) e publique de novo.
# ADMIN_USER=admin_procidadan
# ADMIN_PASSWORD=
