{
  "name": "nexo-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=1 src/test/*.test.ts",
    "setup:env": "tsx src/scripts/setup-env.ts",
    "db:migrate": "tsx src/scripts/migrate.ts",
    "db:seed": "tsx src/scripts/migrate.ts --seed",
    "db:purge": "tsx src/scripts/purge.ts",
    "qr": "tsx src/scripts/qr.ts",
    "admin": "tsx src/scripts/admin.ts",
    "start": "tsx src/index.ts",
    "admin:ensure": "tsx src/scripts/ensure-admin.ts",
    "start:prod": "npm run db:seed && npm run admin:ensure && npm start"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "sharp": "^0.33.5",
    "tsx": "^4.19.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=22"
  }
}
